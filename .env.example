# ===== Обязательные =====
# Получить на https://my.telegram.org -> API development tools
API_ID=
API_HASH=
# Номер в международном формате, например +79991234567
PHONE=
# Заполняется после запуска: python utils/session_gen.py
SESSION_STRING=

# ===== Автоответчик =====
# Задержка перед ответом (секунды): от 2 до 5 минут
REPLY_DELAY_MIN=120
REPLY_DELAY_MAX=300
# Максимум автоответов в час
MAX_REPLIES_PER_HOUR=20
# Белый список (отвечать только им) и чёрный (никогда не отвечать).
# Через запятую: username без @ или числовой id. Пусто = не используется.
WHITELIST=
BLACKLIST=
# Фраза по умолчанию. Можно использовать {name}, {time}, {date}
DEFAULT_REPLY=Привет, {name}! Сейчас не могу ответить, отвечу позже.

# ===== AI-ответы (необязательно) =====
# Если ключа нет — используются шаблоны и фраза по умолчанию
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_SYSTEM_PROMPT=Ты — вежливый помощник владельца аккаунта. Отвечай коротко (1-3 предложения), дружелюбно, на языке собеседника. Не выдумывай факты и не давай обещаний от имени владельца. Скажи, что владелец скоро ответит лично.

# Задачи «нужно ответить» (необязательно)
TASK_MAX_AGE_HOURS=48
CATCHUP_HOURS=24
REPLY_QUOTE_CHANCE=35
TEMPLATE_EXTRA_WORDS=4
LOWERCASE_REPLIES=1
SMILE_KEEP_CHANCE=20
